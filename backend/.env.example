# Copy to .env and fill in real values (never commit .env).
#
# Only OPENAI_API_KEY is REQUIRED — the server fail-fasts on startup if it is
# missing (and lists only the missing key NAME, never its value).
# Market prices use Yahoo Finance (yfinance): FREE, delayed, no key needed.
# TAVILY / SEC power the report's news + filing/risk sections; if absent those
# sections degrade honestly (an explanatory note) and never block the analysis.

# LLM for language understanding / routing only — numbers are computed in code. (REQUIRED)
OPENAI_API_KEY=

# News search for the report's "Related Events" section (https://tavily.com). (optional)
TAVILY_API_KEY=

# SEC EDGAR identifying User-Agent, e.g. "Your Name you@example.com" — powers the
# report's Financial & Filing Highlights + Business Risks sections. (optional)
SEC_USER_AGENT=
