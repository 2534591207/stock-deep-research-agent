# Copy to .env and fill in real values (never commit .env).
#
# Only OPENAI_API_KEY is REQUIRED — the server fail-fasts on startup if it is
# missing (it lists only the missing key NAME, never its value).
# Market prices use Yahoo Finance (yfinance): free, delayed, no key needed.

# LLM for language understanding / routing / narration — numbers are computed in
# code, never by the model. (REQUIRED)
OPENAI_API_KEY=

# News search for the report's "Related Events" section (https://tavily.com).
# Optional — the section degrades honestly when absent. (optional)
TAVILY_API_KEY=

# SEC EDGAR identifying User-Agent, e.g. "Your Name you@example.com" — powers the
# report's Financial & Filing Highlights + Business Risks sections. (optional)
SEC_USER_AGENT=

# Image host for report price-trend charts: a PUBLIC GitHub repo the backend
# uploads chart PNGs to, so a downloaded report renders its chart anywhere.
# Optional — charts fall back to a server-hosted path when absent. (optional)
GITHUB_TOKEN=
GITHUB_IMAGE_REPO=your-username/your-repo
GITHUB_IMAGE_BRANCH=report-assets
